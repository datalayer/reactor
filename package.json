{
  "name": "@datalayer/reactor",
  "version": "0.1.0",
  "description": "Extension reactor with framework-agnostic core and React bridge",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lib": "gulp --gulpfile gulpfile.cjs resources-to-lib && tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example:dev": "npm run dev --prefix examples/frontend",
    "example:dev:frontend-backend": "npm run dev --prefix examples/frontend-backend",
    "watch:lib": "tsc -w"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "gulp": "^4.0.2",
    "gulp-append-prepend": "^1.0.8",
    "gulp-filter": "^6.0.0",
    "gulp-watch": "^5.0.1",
    "typescript": "^5.8.3"
  }
}