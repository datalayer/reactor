              {
                "$ref": "#/$defs/PatchRemove"
              },
              {
                "$ref": "#/$defs/PatchReplace"
              },
              {
                "$ref": "#/$defs/PatchMove"
              },
              {
                "$ref": "#/$defs/PatchCopy"
              },
              {
                "$ref": "#/$defs/PatchTest"
              }
            ]
          },
          "title": "Body",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "op": {
          "const": "patch",
          "default": "patch",
          "title": "Op",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "v": {
