          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "path",
        "op",
        "value"
      ],
      "title": "PatchAdd",
      "type": "object"
    },
    "PatchCopy": {
      "additionalProperties": false,
