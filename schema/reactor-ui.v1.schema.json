{
  "$defs": {
    "ActionFrame": {
      "additionalProperties": false,
      "description": "Up: a press of something a display offered. ``ref`` names its result.",
      "properties": {
        "action": {
          "$ref": "#/$defs/UiAction"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "t": {
          "const": "action",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "ref",
        "action"
      ],
      "title": "ActionFrame",
      "type": "object"
    },
    "ActionOffer": {
      "additionalProperties": false,
      "description": "Something a display lets the page press.\n\n``token`` is minted by the server for this display, this session and this\naction (:meth:`reactor.ui.actions.ActionRegistry.offer`): only what was\noffered can be pressed.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "name",
        "token"
      ],
      "title": "ActionOffer",
      "type": "object"
    },
    "AppendBody": {
      "additionalProperties": false,
      "description": "What an ``append`` pushes, and onto which array of the display.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "path"
      ],
      "title": "AppendBody",
      "type": "object"
    },
    "AppendOp": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/AppendBody"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "op": {
          "const": "append",
          "default": "append",
          "title": "Op",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "id",
        "body"
      ],
      "title": "AppendOp",
      "type": "object"
    },
    "AskOp": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/DisplayWire"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "op": {
          "const": "ask",
          "default": "ask",
          "title": "Op",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "body"
      ],
      "title": "AskOp",
      "type": "object"
    },
    "DisplayWire": {
      "additionalProperties": false,
      "description": "A display as it travels: the shape a renderer receives.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/ActionOffer"
          },
          "title": "Actions",
          "type": "array"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "text"
      ],
      "title": "DisplayWire",
      "type": "object"
    },
    "DownFrame": {
      "discriminator": {
        "mapping": {
          "op": "#/$defs/OpFrame",
          "ping": "#/$defs/PingFrame",
          "pong": "#/$defs/PongFrame",
          "result": "#/$defs/ResultFrame",
          "welcome": "#/$defs/WelcomeFrame"
        },
        "propertyName": "t"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/WelcomeFrame"
        },
        {
          "$ref": "#/$defs/OpFrame"
        },
        {
          "$ref": "#/$defs/ResultFrame"
        },
        {
          "$ref": "#/$defs/PingFrame"
        },
        {
          "$ref": "#/$defs/PongFrame"
        }
      ]
    },
    "FileRef": {
      "additionalProperties": false,
      "description": "A file by reference: uploaded, or offered for download.\n\nFiles never ride inside JSON. ``ref`` is the host's handle on the bytes;\n``url`` is where the page may fetch them, signed and short-lived when it is\nthere at all.",
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "ref",
        "name",
        "media_type"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "HelloFrame": {
      "additionalProperties": false,
      "description": "Up, first and only once: who connects, to which scope, from where.\n\n``token`` is the credential the host's ``authenticate`` checks \u2014 sent in\nthe first frame, never in the URL. ``since`` is the last sequence number\nthe page applied: the ops after it are sent again (a resume); none, and\nevery op the host still keeps for the scope is sent.",
      "properties": {
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "since": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        },
        "t": {
          "const": "hello",
          "title": "T",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "t",
        "token",
        "scope"
      ],
      "title": "HelloFrame",
      "type": "object"
    },
    "MetaOp": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "additionalProperties": true,
          "title": "Body",
          "type": "object"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "op": {
          "const": "meta",
          "default": "meta",
          "title": "Op",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "body"
      ],
      "title": "MetaOp",
      "type": "object"
    },
    "OpFrame": {
      "additionalProperties": false,
      "description": "Down: one op, numbered. Within a scope the numbers go up by one, with\nno gap: a page that sees a gap reconnects with ``since``.",
      "properties": {
        "op": {
          "discriminator": {
            "mapping": {
              "append": "#/$defs/AppendOp",
              "ask": "#/$defs/AskOp",
              "meta": "#/$defs/MetaOp",
              "patch": "#/$defs/PatchOp",
              "remove": "#/$defs/RemoveOp",
              "show": "#/$defs/ShowOp",
              "state": "#/$defs/StateOp",
              "window": "#/$defs/WindowOp"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ShowOp"
            },
            {
              "$ref": "#/$defs/PatchOp"
            },
            {
              "$ref": "#/$defs/AppendOp"
            },
            {
              "$ref": "#/$defs/RemoveOp"
            },
            {
              "$ref": "#/$defs/StateOp"
            },
            {
              "$ref": "#/$defs/AskOp"
            },
            {
              "$ref": "#/$defs/WindowOp"
            },
            {
              "$ref": "#/$defs/MetaOp"
            }
          ],
          "title": "Op"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "t": {
          "const": "op",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "seq",
        "op"
      ],
      "title": "OpFrame",
      "type": "object"
    },
    "PatchAdd": {
      "additionalProperties": false,
      "description": "RFC 6902 ``add``. ``value`` must be there; ``null`` is a value.",
