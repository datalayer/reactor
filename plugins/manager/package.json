{
  "name": "@datalayer/reactor-manager",
  "version": "1.0.0",
  "description": "The plugins manager for a Datalayer Reactor platform — lists every plugin and switches each one on and off while the application runs.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "datalayer",
    "reactor",
    "plugins",
    "manager"
  ],
  "dependencies": {
    "@datalayer/primer-addons": "^1.0.17",
    "@datalayer/reactor": "^1.0.0",
    "@primer/octicons-react": "^19.9.0",
    "@primer/react": "^37.31.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf lib"
  }
}
