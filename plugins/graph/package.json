{
  "name": "@datalayer/reactor-graph",
  "version": "1.0.0",
  "description": "Renders the plugin graph of a Datalayer Reactor platform \u2014 extensions, dependencies, contribution points and their contributors, across the frontend and backend tiers.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "datalayer",
    "reactor",
    "plugins",
    "graph",
    "echarts"
  ],
  "dependencies": {
    "@datalayer/primer-addons": "^1.0.17",
    "@primer/react": "^37.31.0",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@datalayer/reactor": "^1.0.0",
    "react": ">=18"
  }
}
