{
  "name": "@datalayer/reactor-mermaid",
  "version": "1.3.11",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datalayer/reactor.git",
    "directory": "plugins/mermaid"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Mermaid diagrams as AI agent tools for a Datalayer Reactor platform: write a diagram's source, read it back, validate it with mermaid's parser, render it to SVG, and list the diagram types.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "datalayer",
    "reactor",
    "plugins",
    "mermaid",
    "agent",
    "tools"
  ],
  "devDependencies": {
    "mermaid": "^10.9.8 || ^11.0.0",
    "typescript": "5.9.3",
    "zod": "^4.1.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fully-specify-lib.mjs lib",
    "check:pack": "node ../../scripts/check-npm-pack.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@datalayer/reactor": "^1.3.0",
    "zod": ">=3.23"
  }
}
