---
import Base from '../layouts/Base.astro';
import { cms } from '../lib/cms';
import { getLiveCollection } from 'astro:content';
const bootstrap = await cms.bootstrap();
const { entries: livePosts, error } = await getLiveCollection('posts', { limit: 20 });
if (error) throw error;
const posts = livePosts ?? [];
---
<Base {bootstrap}>
  <section class="hero">
    <p class="eyebrow">Stories, notes and ideas</p>
    <h1>{bootstrap.site.tagline}</h1>
    <p class="hero-copy">A living publication powered by Astro, edited collaboratively, and delivered from the Reactor CMS.</p>
  </section>
  <section>
    <div class="section-heading"><h2>Latest stories</h2><a href="/blog">View the journal →</a></div>
    <div class="post-grid">{posts.map(({ data: post }, index) => <article class:list={{'post-card':true,featured:post.data.featured === true}}><div><span class="post-number">{String(index + 1).padStart(2, '0')}</span><span class="post-meta">{String(post.data.category ?? 'Journal')}</span><h2><a href={`/posts/${post.slug}`}>{post.title}</a></h2><p>{post.excerpt}</p></div><div class="card-footer"><span>{String(post.data.readingTime ?? '5 min')} read</span><a href={`/posts/${post.slug}`}>Read story →</a></div></article>)}</div>
  </section>
</Base>
