---
import type { Bootstrap } from '../lib/cms';
import PublicExtensionHost from '../components/PublicExtensionHost.astro';
import { ClientRouter } from 'astro:transitions';

interface Props { bootstrap: Bootstrap; title?: string; description?: string }
const { bootstrap, title = bootstrap.site.name, description = bootstrap.site.tagline } = Astro.props;
const primary = bootstrap.menus.find((menu) => menu.slug === 'primary');
const tokens = bootstrap.site.tokens;
const theme = bootstrap.site.theme_slug;
const systemFont = '-apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji"';
type CssVariables = Record<`--${string}`, string>;
const parseVariables = (value: string | undefined): CssVariables => {
  try {
    const parsed = JSON.parse(value ?? '{}') as Record<string, unknown>;
    return Object.fromEntries(Object.entries(parsed).filter(([key, item]) => key.startsWith('--') && typeof item === 'string')) as CssVariables;
  } catch { return {}; }
};
const fallbackLight: CssVariables = {
  '--bgColor-default': '#f7f5f0', '--bgColor-muted': '#ffffff', '--fgColor-default': '#171717',
  '--fgColor-muted': '#64615b', '--fgColor-onEmphasis': '#ffffff', '--fgColor-accent': tokens.accent ?? '#8250df',
  '--bgColor-accent-emphasis': tokens.accent ?? '#8250df', '--borderColor-default': '#ddd8ce', '--borderColor-muted': '#ebe7df',
  '--fontStack-sansSerif': systemFont, '--fontStack-sansSerifDisplay': systemFont,
};
const fallbackDark: CssVariables = {
  '--bgColor-default': '#0d1117', '--bgColor-muted': '#161b22', '--fgColor-default': '#f0f6fc',
  '--fgColor-muted': '#8b949e', '--fgColor-onEmphasis': '#ffffff', '--fgColor-accent': tokens.accent ?? '#a371f7',
  '--bgColor-accent-emphasis': tokens.accent ?? '#8250df', '--borderColor-default': '#30363d', '--borderColor-muted': '#21262d',
  '--fontStack-sansSerif': systemFont, '--fontStack-sansSerifDisplay': systemFont,
};
const lightVariables = {...fallbackLight, ...parseVariables(bootstrap.settings['appearance.tokens.light'])};
const darkVariables = {...fallbackDark, ...parseVariables(bootstrap.settings['appearance.tokens.dark'])};
const declarations = (variables: CssVariables) => Object.entries(variables).map(([name,value]) => `${name}:${value}`).join(';');
const appearanceTheme = bootstrap.settings['appearance.theme'] ?? 'datalayer';
const colorMode = bootstrap.settings['appearance.colorMode'] ?? 'auto';
const apiUrl = import.meta.env.CMS_API_URL ?? 'http://localhost:8791';
const appearanceCss = `:root[data-color-mode='light']{color-scheme:light;${declarations(lightVariables)}}:root[data-color-mode='dark']{color-scheme:dark;${declarations(darkVariables)}}@media(prefers-color-scheme:light){:root[data-color-mode='auto']{color-scheme:light;${declarations(lightVariables)}}}@media(prefers-color-scheme:dark){:root[data-color-mode='auto']{color-scheme:dark;${declarations(darkVariables)}}}`;
---
<!doctype html>
<html lang={bootstrap.settings.locale ?? 'en'} data-site-theme={theme} data-color-mode={colorMode} data-light-theme={appearanceTheme} data-dark-theme={appearanceTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <style is:inline set:html={appearanceCss}></style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/"><span class="brand-mark">A</span><span>{bootstrap.site.name}</span><small>{theme} layout</small></a>
        <nav aria-label="Primary navigation">
          {primary?.items.map((item) => <a class:list={{active: Astro.url.pathname === item.url}} href={item.url}>{item.label}</a>)}
          <a class="cms-link" href="/_cms/login">CMS login <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-inner">
        <strong>{bootstrap.site.name}</strong>
        {bootstrap.widgets.filter((widget) => widget.area === 'footer').map((widget) => <span>{String(widget.data.text ?? '')}</span>)}
        <a href="/_cms/content">Manage content</a>
      </div>
    </footer>
    <PublicExtensionHost
      apiUrl={apiUrl}
      siteId={bootstrap.site.id}
      siteName={bootstrap.site.name}
      appearanceTheme={appearanceTheme}
      colorMode={colorMode}
    />
  </body>
</html>
<script>
  const refreshEvent = 'cms-astro:refresh-view';
  const refreshedEvent = 'cms-astro:view-refreshed';
  const refreshWindow = window as Window & { __cmsAstroRefreshViewInstalled?: boolean };
  const documentThemeAttributes = [
    'lang',
    'data-site-theme',
    'data-color-mode',
    'data-light-theme',
    'data-dark-theme',
  ];

  if (!refreshWindow.__cmsAstroRefreshViewInstalled) {
    refreshWindow.__cmsAstroRefreshViewInstalled = true;
    document.addEventListener(refreshEvent, event => {
      const requestId = (event as CustomEvent<{ requestId?: string }>).detail?.requestId;
      void fetch(window.location.href, {
        cache: 'no-store',
        headers: { Accept: 'text/html' },
      })
        .then(async response => {
          if (!response.ok) throw new Error(`Website refresh failed with HTTP ${response.status}`);
          const nextDocument = new DOMParser().parseFromString(await response.text(), 'text/html');
          const currentMain = document.querySelector('main');
          const nextMain = nextDocument.querySelector('main');
          if (!currentMain || !nextMain) throw new Error('Website refresh response has no content');

          currentMain.replaceWith(document.importNode(nextMain, true));
          document.title = nextDocument.title;
          for (const attribute of documentThemeAttributes) {
            const value = nextDocument.documentElement.getAttribute(attribute);
            if (value === null) document.documentElement.removeAttribute(attribute);
            else document.documentElement.setAttribute(attribute, value);
          }
          document.dispatchEvent(
            new CustomEvent(refreshedEvent, {
              detail: { requestId, url: window.location.href },
            }),
          );
        })
        .catch(error => {
          document.dispatchEvent(
            new CustomEvent(refreshedEvent, {
              detail: {
                requestId,
                url: window.location.href,
                error: error instanceof Error ? error.message : String(error),
              },
            }),
          );
        });
    });
  }
</script>
<style is:global>
  :root{--font:var(--fontStack-sansSerif);--display:var(--fontStack-sansSerifDisplay,var(--fontStack-sansSerif))}
  *{box-sizing:border-box}html{background:var(--bgColor-default)}body{margin:0;min-height:100vh;font-family:var(--font);color:var(--fgColor-default);background:radial-gradient(circle at 85% 0,color-mix(in srgb,var(--bgColor-accent-emphasis) 9%,transparent),transparent 32rem),var(--bgColor-default)}
  a{color:inherit}.site-header{position:sticky;top:0;z-index:10;border-bottom:1px solid color-mix(in srgb,var(--borderColor-default) 75%,transparent);background:color-mix(in srgb,var(--bgColor-default) 88%,transparent);backdrop-filter:blur(14px)}
  .header-inner,.footer-inner,main{width:min(1120px,calc(100% - 40px));margin:auto}.header-inner{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:flex;align-items:center;gap:11px;text-decoration:none;font-family:var(--display);font-size:1.08rem;font-weight:800}.brand-mark{width:32px;height:32px;display:grid;place-items:center;border-radius:9px;color:var(--fgColor-onEmphasis);background:var(--bgColor-accent-emphasis);font-family:var(--font);font-size:.9rem;box-shadow:0 8px 24px color-mix(in srgb,var(--bgColor-accent-emphasis) 25%,transparent)}
  nav{display:flex;align-items:center;gap:6px}nav a{padding:8px 11px;border-radius:7px;text-decoration:none;color:var(--fgColor-muted);font-size:.9rem;font-weight:600}nav a:hover,nav a.active{color:var(--fgColor-default);background:color-mix(in srgb,var(--bgColor-muted) 70%,transparent)}nav .cms-link{margin-left:8px;padding-inline:14px;color:var(--fgColor-onEmphasis);background:var(--bgColor-accent-emphasis)}nav .cms-link:hover{color:var(--fgColor-onEmphasis);background:color-mix(in srgb,var(--bgColor-accent-emphasis) 86%,#000)}
  main{min-height:calc(100vh - 190px);padding:70px 0 90px}.eyebrow{margin:0 0 14px;color:var(--fgColor-accent);font-size:.78rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.hero{max-width:820px;margin-bottom:62px}.hero h1,.article-header h1{margin:0;font-family:var(--display);font-size:clamp(2.7rem,7vw,5.5rem);line-height:.98;letter-spacing:-.045em}.hero-copy{max-width:650px;margin:24px 0 0;color:var(--fgColor-muted);font-size:1.15rem;line-height:1.7}
  .section-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:20px}.section-heading h2{margin:0;font-family:var(--display);font-size:1.8rem}.section-heading a{color:var(--fgColor-accent);font-weight:700;text-decoration:none}.post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.post-card{min-height:220px;padding:28px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid var(--borderColor-default);border-radius:18px;background:color-mix(in srgb,var(--bgColor-muted) 92%,transparent);box-shadow:0 15px 45px rgba(33,28,20,.06);transition:transform .18s ease,border-color .18s ease}.post-card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--fgColor-accent) 45%,var(--borderColor-default))}.post-card a{text-decoration:none}.post-card h2,.post-card h3{margin:8px 0 12px;font-family:var(--display);font-size:1.65rem;line-height:1.15}.post-card p{margin:0;color:var(--fgColor-muted);line-height:1.65}.post-meta{color:var(--fgColor-accent);font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
  .brand small{padding:3px 7px;border:1px solid var(--borderColor-default);border-radius:999px;color:var(--fgColor-muted);font:600 .62rem/1 var(--font);letter-spacing:.08em;text-transform:uppercase}.post-number{display:none}.card-footer{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:28px;color:var(--fgColor-muted);font-size:.82rem}.card-footer a{color:var(--fgColor-accent);font-weight:750}
  :root[data-site-theme='editorial'] .hero{padding-bottom:50px;border-bottom:1px solid var(--borderColor-default)}:root[data-site-theme='editorial'] .post-card.featured{grid-column:1/-1;min-height:330px;padding:44px}:root[data-site-theme='editorial'] .post-card.featured h2{max-width:720px;font-size:clamp(2.2rem,5vw,4rem)}:root[data-site-theme='editorial'] .post-card.featured p{max-width:680px;font-size:1.08rem}
  :root[data-site-theme='studio'] .header-inner,:root[data-site-theme='studio'] .footer-inner,:root[data-site-theme='studio'] main{width:min(1320px,calc(100% - 48px))}:root[data-site-theme='studio'] .brand-mark{border-radius:50%}:root[data-site-theme='studio'] main{padding-top:44px}:root[data-site-theme='studio'] .hero{max-width:none;display:grid;grid-template-columns:minmax(260px,.75fr) minmax(420px,1.25fr);grid-template-rows:auto 1fr;column-gap:70px;align-items:end;margin-bottom:48px}:root[data-site-theme='studio'] .hero .eyebrow{grid-column:1}:root[data-site-theme='studio'] .hero h1{grid-column:1;font-size:clamp(2.5rem,5vw,4.4rem)}:root[data-site-theme='studio'] .hero-copy{grid-column:2;grid-row:1/3;margin:0;padding:28px;border-left:4px solid var(--bgColor-accent-emphasis);font-size:1.3rem}:root[data-site-theme='studio'] .post-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--borderColor-default);border:1px solid var(--borderColor-default)}:root[data-site-theme='studio'] .post-card,:root[data-site-theme='studio'] .post-card.featured{grid-column:auto;min-height:300px;border:0;border-radius:0;box-shadow:none}:root[data-site-theme='studio'] .post-card:hover{transform:none;background:color-mix(in srgb,var(--bgColor-accent-emphasis) 8%,var(--bgColor-muted))}:root[data-site-theme='studio'] .post-number{display:block;float:right;color:var(--fgColor-muted);font:700 1.8rem/1 var(--display)}:root[data-site-theme='studio'] .post-card h2{font-size:1.45rem}
  .article-header{max-width:850px;margin-bottom:42px}.article-header h1{font-size:clamp(2.5rem,6vw,4.6rem)}.article-header p{color:var(--fgColor-muted);font-size:1.2rem;line-height:1.65}.article-body{max-width:760px;padding:34px;border:1px solid var(--borderColor-default);border-radius:18px;background:var(--bgColor-muted);font:1.05rem/1.8 var(--font)}.published-lexical,.published-content-input{width:100%;min-height:1em}.published-content-input{padding:0;outline:0;font:inherit;color:inherit}.published-lexical p,.published-lexical .JupyterLexicalTheme__paragraph,.published-lexical .CommentEditorTheme__paragraph{margin:0 0 1.15em}.published-lexical h1,.published-lexical h2,.published-lexical h3,.published-lexical h4,.published-lexical h5,.published-lexical h6,.published-lexical .JupyterLexicalTheme__h1,.published-lexical .JupyterLexicalTheme__h2,.published-lexical .JupyterLexicalTheme__h3,.published-lexical .JupyterLexicalTheme__h4,.published-lexical .JupyterLexicalTheme__h5,.published-lexical .JupyterLexicalTheme__h6{margin:1.35em 0 .55em;color:var(--fgColor-default);font-family:var(--display);font-weight:750;line-height:1.15;text-transform:none}.published-lexical h1,.published-lexical .JupyterLexicalTheme__h1{font-size:2.25rem}.published-lexical h2,.published-lexical .JupyterLexicalTheme__h2{font-size:1.75rem}.published-lexical h3,.published-lexical .JupyterLexicalTheme__h3{font-size:1.35rem}.published-lexical img,.published-lexical iframe{max-width:100%}.published-youtube{width:100%;aspect-ratio:16/9;border:0}.published-equation.block{overflow-x:auto;text-align:center}.published-excalidraw{display:grid;min-height:160px;margin:1.5em 0;place-items:center;border:1px dashed var(--borderColor-default);border-radius:10px;color:var(--fgColor-muted)}
  footer{border-top:1px solid var(--borderColor-default);background:color-mix(in srgb,var(--bgColor-muted) 55%,transparent)}.footer-inner{min-height:116px;display:flex;align-items:center;gap:22px;color:var(--fgColor-muted);font-size:.88rem}.footer-inner strong{color:var(--fgColor-default)}.footer-inner a{margin-left:auto;color:var(--fgColor-accent);font-weight:700;text-decoration:none}
  @media(max-width:850px){:root[data-site-theme='studio'] .hero{display:block}:root[data-site-theme='studio'] .hero-copy{margin-top:24px}:root[data-site-theme='studio'] .post-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:700px){.header-inner{align-items:flex-start;padding:15px 0}.header-inner,nav{flex-wrap:wrap}nav{width:100%}.cms-link{margin-left:auto!important}.post-grid,:root[data-site-theme='studio'] .post-grid{grid-template-columns:1fr}main{padding-top:48px}.footer-inner{padding:25px 0;align-items:flex-start;flex-direction:column}.footer-inner a{margin-left:0}:root[data-site-theme='editorial'] .post-card.featured{padding:28px}}
</style>
